{
  "name": "kiwit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "tsc:check": "tsc --noEmit",
    "check": "biome check --write . && tsc --noEmit",
    "check:ci": "biome ci . && tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.80.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
